      "name": "Получаем сделку по айди"
    },
    {
      "parameters": {
        "jsCode": "const data = [];\nconst errors = [];\n\nfor (const item of $input.all()) {\n  const deal = item.json.result;\n\n  if (deal) {\n    data.push({\n      id: deal.id,\n      title: deal.title ?? '',\n      amount: deal.amount ?? null,\n      responsible: {\n        id: deal.responsible?.id ?? null,\n        name: deal.responsible?.name ?? '',\n      },\n      company: {\n        id: deal.company?.id ?? null,\n        name: deal.company?.name ?? '',\n      },\n    });\n  } else {\n    const message =\n      item.json.error ?? 'Неизвестная ошибка получения сделки';\n\n    const idMatch = String(message).match(/ID\\s+(\\d+)/i);\n\n    errors.push({\n      id: idMatch ? Number(idMatch[1]) : null,\n      message: String(message),\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      success: errors.length === 0,\n      total: data.length,\n      data,\n      errors,\n    },\n  },\n];"
      },
